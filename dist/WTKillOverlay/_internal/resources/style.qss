QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 14px;
    color: #e5e7eb;
    background: #0f172a;
}

QMainWindow, QTabWidget::pane, QScrollArea {
    background: #0f172a;
}

QTabBar::tab {
    background: #1e293b;
    color: #cbd5e1;
    padding: 11px 20px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #2563eb;
    color: white;
}

QGroupBox, QFrame#levelCard {
    border: 1px solid #334155;
    border-radius: 10px;
    margin-top: 10px;
    padding: 14px;
    background: #111827;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: #f8fafc;
}

QLabel#pageTitle {
    font-size: 28px;
    font-weight: 700;
    color: #ffffff;
}

QLabel#cardTitle {
    font-size: 19px;
    font-weight: 700;
    color: #ffffff;
}

QLabel#muted {
    color: #94a3b8;
}

QLabel#notice {
    color: #dbeafe;
    background: #172554;
    border: 1px solid #1d4ed8;
    border-radius: 8px;
    padding: 12px;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #020617;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 7px;
    selection-background-color: #2563eb;
}

QPushButton {
    background: #334155;
    border: 1px solid #475569;
    border-radius: 7px;
    padding: 8px 14px;
}

QPushButton:hover {
    background: #475569;
}

QPushButton:disabled {
    color: #64748b;
    background: #1e293b;
}

QPushButton#primaryButton {
    background: #2563eb;
    border-color: #3b82f6;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background: #1d4ed8;
}

QCheckBox {
    spacing: 8px;
}

QScrollBar:vertical {
    background: #0f172a;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #475569;
    border-radius: 6px;
    min-height: 28px;
}
